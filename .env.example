# Kumoko Scan - variaveis de ambiente da stack Docker Compose.
# Copie para .env (cp .env.example .env) e TROQUE todos os segredos antes de usar.
# Os servicos Nest leem nomes genericos (DB_NAME, DB_USER...); o docker-compose.yml
# faz o mapeamento a partir das variaveis especificas abaixo.

# ---------- Geral ----------
COMPOSE_PROJECT_NAME=kumoko-scan
NODE_ENV=production
LOG_LEVEL=info
# Host publico usado no certificado autoassinado (SAN) do gateway.
PUBLIC_HOST=localhost
# Portas publicadas no host pelo gateway (unico container exposto).
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443
# Origens permitidas no CORS (separadas por virgula).
CORS_ORIGINS=https://localhost:8443,http://localhost:5173

# ---------- MariaDB (um banco e um usuario por servico) ----------
MARIADB_ROOT_PASSWORD=troque-root
AUTH_DB_NAME=kumoko_auth
AUTH_DB_USER=kumoko_auth
AUTH_DB_PASSWORD=troque-auth
CATALOG_DB_NAME=kumoko_catalog
CATALOG_DB_USER=kumoko_catalog
CATALOG_DB_PASSWORD=troque-catalog
ORDER_DB_NAME=kumoko_orders
ORDER_DB_USER=kumoko_orders
ORDER_DB_PASSWORD=troque-orders

# ---------- Redis (cache-aside e Pub/Sub) ----------
REDIS_PASSWORD=troque-redis
CACHE_TTL_SECONDS=60

# ---------- JWT (minimo de 32 caracteres) ----------
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=1h

# ---------- Administrador inicial (criado/atualizado no boot do auth-service) ----------
ADMIN_NAME=Administrador Kumoko
ADMIN_EMAIL=admin@kumoko.local
ADMIN_PASSWORD=Admin@Kumoko2026
ADMIN_CPF=52998224725

# ---------- Catalogo ----------
# Popula o catalogo com as capas de backend/apps/catalog-service/seed/covers se estiver vazio.
SEED_CATALOG=true

# ---------- Observabilidade (Prometheus + Grafana) ----------
# Senha do usuario "admin" do Grafana (https://localhost:8443/grafana/). Troque antes de usar.
GRAFANA_ADMIN_PASSWORD=troque-grafana
# Retencao das series no Prometheus (opcional).
PROMETHEUS_RETENTION=15d
