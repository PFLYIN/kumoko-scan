# Execucao local do catalog-service (copie para apps/catalog-service/.env).
NODE_ENV=development
PORT=3002
SERVICE_NAME=catalog-service
LOG_LEVEL=debug
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kumoko_catalog
DB_USER=kumoko_catalog
DB_PASSWORD=troque-catalog
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=troque-redis
JWT_SECRET=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
CORS_ORIGINS=http://localhost:5173
CACHE_TTL_SECONDS=60
UPLOADS_DIR=./uploads
SEED_CATALOG=true
SEED_COVERS_DIR=./apps/catalog-service/seed/covers
