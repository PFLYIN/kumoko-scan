{
  "name": "kumoko-backend",
  "version": "1.0.0",
  "description": "Monorepo NestJS dos microsservicos do Kumoko Scan (auth, catalog, order)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nest build auth-service && nest build catalog-service && nest build order-service",
    "build:auth-service": "nest build auth-service",
    "build:catalog-service": "nest build catalog-service",
    "build:order-service": "nest build order-service",
    "start:dev:auth-service": "nest start auth-service --watch",
    "start:dev:catalog-service": "nest start catalog-service --watch",
    "start:dev:order-service": "nest start order-service --watch",
    "start:prod:auth-service": "node dist/apps/auth-service/main.js",
    "start:prod:catalog-service": "node dist/apps/catalog-service/main.js",
    "start:prod:order-service": "node dist/apps/order-service/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "lint:fix": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "format:check": "prettier --check \"{apps,libs}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.3.2",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nestjs-pino": "^5.3.1",
    "opossum": "^10.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^12.5.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.m?js$": "<rootDir>/jest/esm-to-cjs.transformer.js"
    },
    "moduleNameMapper": {
      "^@kumoko/common(|/.*)$": "<rootDir>/libs/common/src$1",
      "^@kumoko/security(|/.*)$": "<rootDir>/libs/security/src$1",
      "^@kumoko/observability(|/.*)$": "<rootDir>/libs/observability/src$1",
      "^@kumoko/cache(|/.*)$": "<rootDir>/libs/cache/src$1",
      "^@kumoko/messaging(|/.*)$": "<rootDir>/libs/messaging/src$1"
    },
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "libs/**/*.ts",
      "!**/main.ts",
      "!**/index.ts",
      "!**/*.module.ts",
      "!**/database/migrations/**",
      "!**/testing/**"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "transformIgnorePatterns": []
  }
}
