# Gateway Kumoko Scan. Processado pelo envsubst da imagem oficial do nginx
# (NGINX_ENVSUBST_FILTER=^NGINX_), entao $host, $request_uri etc. nao sao tocados.

# HTTP: apenas healthcheck e redirecionamento permanente para HTTPS.
server {
    listen 80 default_server;
    server_name _;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host:${NGINX_HTTPS_PORT}$request_uri;
    }
}

# HTTPS: ponto de entrada unico da aplicacao.
server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 10m;

    include /etc/nginx/conf.d/snippets/security-headers.conf;

    # Erros gerados pelo proprio gateway seguem o formato JSON padrao da API.
    error_page 429 = @rate_limited;
    error_page 502 503 504 = @upstream_unavailable;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # /health e /metrics dos servicos sao internos (rede kumoko_net).
    location ~ ^/(health|metrics)(/|$) {
        return 404;
    }

    # ---------- auth-service ----------
    location /api/auth/ {
        limit_req zone=api_limit burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://auth_service;

        # Login e cadastro: limite estrito contra forca bruta. O restante de
        # /api/auth/ (logout, Swagger em /api/auth/docs) usa o limite geral.
        location ~ ^/api/auth/(login|register)/?$ {
            limit_req zone=auth_limit burst=5 nodelay;
            limit_req zone=api_limit burst=40 nodelay;
            include /etc/nginx/snippets/proxy.conf;
            proxy_pass http://auth_service;
        }
    }

    location /api/users/ {
        limit_req zone=api_limit burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://auth_service;
    }

    # ---------- catalog-service ----------
    location /api/obras {
        limit_req zone=api_limit burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://catalog_service;
    }

    location /api/capitulos {
        limit_req zone=api_limit burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://catalog_service;
    }

    location /api/paginas {
        limit_req zone=api_limit burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://catalog_service;
    }

    location /api/catalog/ {
        limit_req zone=api_limit burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://catalog_service;
    }

    # ---------- order-service ----------
    location /api/pedidos {
        limit_req zone=api_limit burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://order_service;
    }

    location /api/orders/ {
        limit_req zone=api_limit burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://order_service;
    }

    # Qualquer outra rota /api/ nao existe.
    location /api/ {
        default_type application/json;
        return 404 '{"statusCode":404,"error":"Not Found","message":"Rota nao encontrada.","path":"$safe_uri","timestamp":"$time_iso8601","requestId":"$req_id"}';
    }

    # ---------- arquivos enviados (capas e paginas) ----------
    # Servidos direto do volume compartilhado (somente leitura), sem passar pelo Node.
    location ^~ /files/ {
        alias /var/www/uploads/;
        autoindex off;
        limit_except GET {
            deny all;
        }
        # Cache de 7 dias (gera Expires e Cache-Control: max-age=604800).
        expires 7d;
        # Cabecalhos explicitos para arquivos enviados por usuarios (inclui
        # X-Content-Type-Options: nosniff, que impede o navegador de "adivinhar" o tipo).
        include /etc/nginx/conf.d/snippets/security-headers.conf;

        # Nunca expoe arquivos ocultos.
        location ~ /\. {
            return 404;
        }
    }

    # ---------- Grafana (dashboards de observabilidade) ----------
    # Servido em sub-path (GF_SERVER_SERVE_FROM_SUB_PATH). CSP propria: a UI do Grafana
    # precisa de scripts inline/eval, o que a CSP estrita da SPA proibe.
    location = /grafana {
        return 301 https://$host:${NGINX_HTTPS_PORT}/grafana/;
    }

    location ^~ /grafana/ {
        limit_req zone=api_limit burst=200 nodelay;
        include /etc/nginx/conf.d/snippets/security-headers-grafana.conf;
        # Sem snippets/proxy.conf: aqui o cabecalho Connection depende do Upgrade (Grafana Live/WebSocket).
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $req_id;
        proxy_read_timeout 60s;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://grafana;
    }

    # ---------- frontend (SPA) ----------
    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://frontend;
    }

    # ---------- respostas de erro do gateway ----------
    location @rate_limited {
        default_type application/json;
        add_header Retry-After 60 always;
        include /etc/nginx/conf.d/snippets/security-headers.conf;
        return 429 '{"statusCode":429,"error":"Too Many Requests","message":"Muitas requisicoes. Tente novamente em instantes.","path":"$safe_uri","timestamp":"$time_iso8601","requestId":"$req_id"}';
    }

    location @upstream_unavailable {
        default_type application/json;
        return 503 '{"statusCode":503,"error":"Service Unavailable","message":"Servico temporariamente indisponivel. Tente novamente em instantes.","path":"$safe_uri","timestamp":"$time_iso8601","requestId":"$req_id"}';
    }
}
