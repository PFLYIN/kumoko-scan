# Scripts e configs usados dentro de containers Linux precisam de fim de linha LF,
# mesmo em checkouts no Windows (core.autocrlf=true).
*.sh        text eol=lf
*.bash      text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
.env.example text eol=lf

# Binarios
*.jpg  binary
*.jpeg binary
*.png  binary
*.webp binary
*.gif  binary
*.ico  binary
*.cmd text eol=crlf
